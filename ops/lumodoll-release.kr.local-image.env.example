# KR local-image deployment example for first manual rollout.
# This file contains no secrets. Copy to server-side .env when using a preloaded local image.

NETWORK_NAME=proxy-kr
LUMODOLL_RELEASE_HOST=shelf.lumokato.com
# lumokato.com is currently on Cloudflare NS. Use cloudflare after the Traefik token covers this zone.
TRAEFIK_CERTRESOLVER=cloudflare
LUMODOLL_RELEASE_IMAGE=lumodoll-release:arm64

# For DNSPod-managed domains on the existing KR Traefik, use:
# TRAEFIK_CERTRESOLVER=letsencrypt
